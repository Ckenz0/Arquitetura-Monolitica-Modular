# Copie para .env na raiz. Este arquivo é lido apenas pelo servidor.
APP_ENV=development
# Em desenvolvimento, vazio gera uma chave por inicialização.
# Em produção, gere uma chave aleatória estável com pelo menos 32 caracteres.
SECRET_KEY=
# Origens externas exatas, sem barra final. Separe por vírgula.
# A origem que serve o próprio monólito é permitida automaticamente.
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
PORT=5000
